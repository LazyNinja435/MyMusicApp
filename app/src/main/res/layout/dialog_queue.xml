<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bottom_sheet_background"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/_14sdp"
    android:paddingTop="@dimen/_10sdp"
    android:paddingBottom="@dimen/_16sdp">

    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/m3_bottom_sheet_drag_handle" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_8sdp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:accessibilityHeading="true"
            android:fontFamily="@font/avenir_next_bold"
            android:text="@string/queue_title"
            android:textColor="@color/textMain"
            android:textSize="@dimen/_16ssp" />

        <ImageButton
            android:id="@+id/queue_shuffle"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/actionBarItemBackground"
            android:contentDescription="@string/queue_shuffle"
            android:src="@drawable/shuffle_24px"
            app:tint="@color/textSec" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/queue_frame"
        android:layout_width="match_parent"
        android:layout_height="360dp">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/queue_recycler_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="@dimen/_4sdp" />

        <TextView
            android:id="@+id/queue_empty_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:fontFamily="@font/avenir_next_regular"
            android:text="@string/queue_empty"
            android:textColor="@color/textSec"
            android:visibility="gone" />
    </FrameLayout>

    <TextView
        android:id="@+id/queue_loading_recommendations"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:accessibilityLiveRegion="polite"
        android:padding="@dimen/_8sdp"
        android:text="@string/queue_loading_recommendations"
        android:textColor="@color/textSec"
        android:visibility="gone" />
</LinearLayout>
